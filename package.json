{
  "name": "n-infer",
  "version": "0.1.0",
  "description": "Native in-process GGUF inference for Node.js (Rust + llama.cpp via napi-rs)",
  "author": "Robert Serrano",
  "license": "MIT",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    }
  },
  "engines": {
    "node": ">=18"
  },
  "files": [
    "lib"
  ],
  "napi": {
    "name": "n-infer"
  },
  "scripts": {
    "build": "node scripts/build.js",
    "build:cpu": "node scripts/build.js --cpu",
    "build:cuda": "node scripts/build.js --cuda",
    "build:debug": "node scripts/build.js --debug",
    "example": "node examples/basic.js"
  },
  "devDependencies": {
    "@napi-rs/cli": "^2.18.4"
  }
}
