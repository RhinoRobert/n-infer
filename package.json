{
  "name": "n-infer",
  "version": "0.1.0",
  "description": "Native in-process GGUF inference for Node.js (Rust + llama.cpp via napi-rs)",
  "author": "Robert Serrano",
  "license": "MIT",
  "type": "module",
  "main": "index.js",
  "types": "index.d.ts",
  "engines": {
    "node": ">=18"
  },
  "files": [
    "index.js",
    "index.d.ts",
    "*.node"
  ],
  "napi": {
    "name": "n-infer",
    "triples": {
      "defaults": true,
      "additional": [
        "aarch64-unknown-linux-gnu",
        "armv7-unknown-linux-gnueabihf"
      ]
    }
  },
  "scripts": {
    "build": "node scripts/build.js",
    "build:cpu": "node scripts/build.js --cpu",
    "build:cuda": "node scripts/build.js --cuda",
    "build:debug": "node scripts/build.js --debug",
    "example": "node examples/basic.js"
  },
  "devDependencies": {
    "@napi-rs/cli": "^2.18.4"
  }
}
